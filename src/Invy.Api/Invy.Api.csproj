<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Invy Server: REST, SignalR, служба Windows, обнаружение, фид обновлений -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>invy-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invy.Infrastructure\Invy.Infrastructure.csproj" />
    <ProjectReference Include="..\Invy.Contracts\Invy.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Только для `dotnet ef migrations add` (стартовый проект инструментов EF) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Invy.Api.Tests" />
  </ItemGroup>
</Project>
