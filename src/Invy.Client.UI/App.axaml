<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:shell="using:Invy.Client.Core.Shell"
             xmlns:pages="using:Invy.Client.Core.Pages"
             xmlns:views="using:Invy.Client.UI.Views.Pages"
             xmlns:explorer="using:Invy.Client.Core.Explorer"
             xmlns:explorerViews="using:Invy.Client.UI.Views.Explorer"
             xmlns:catalog="using:Invy.Client.Core.Catalog"
             xmlns:catalogViews="using:Invy.Client.UI.Views.Catalog"
             x:Class="Invy.Client.UI.App"
             Name="Invy"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <!-- Стиль Windows 11: системная тема и системный цвет акцента -->
    <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
  </Application.Styles>

  <!-- ViewModel страницы → View -->
  <Application.DataTemplates>
    <DataTemplate DataType="pages:HomePageViewModel">
      <views:HomePage />
    </DataTemplate>
    <DataTemplate DataType="explorer:ExplorerViewModel">
      <explorerViews:ExplorerPage />
    </DataTemplate>
    <DataTemplate DataType="catalog:TypesViewModel">
      <catalogViews:TypesPage />
    </DataTemplate>
    <DataTemplate DataType="catalog:TagsViewModel">
      <catalogViews:TagsPage />
    </DataTemplate>
    <DataTemplate DataType="pages:SettingsPageViewModel">
      <views:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="shell:PlaceholderPageViewModel">
      <views:PlaceholderPage />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
