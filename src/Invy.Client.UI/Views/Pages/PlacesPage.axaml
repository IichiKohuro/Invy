<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:pages="using:Invy.Client.Core.Pages"
             x:Class="Invy.Client.UI.Views.Pages.PlacesPage"
             x:DataType="pages:PlacesPageViewModel">
  <Border Margin="24,4,24,24" CornerRadius="8" BorderThickness="1" Padding="8"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
    <TreeView ItemsSource="{Binding Roots}">
      <TreeView.Styles>
        <!-- Демонстрация вложенности: всё раскрыто -->
        <Style Selector="TreeViewItem">
          <Setter Property="IsExpanded" Value="True" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="pages:PlaceNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Panel Width="20" VerticalAlignment="Center">
              <ui:FASymbolIcon Symbol="Folder" FontSize="18" IsVisible="{Binding IsContainer}"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
              <ui:FASymbolIcon Symbol="Tag" FontSize="18" IsVisible="{Binding !IsContainer}" />
            </Panel>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TypeName}" Opacity="0.55" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Border>
</UserControl>
