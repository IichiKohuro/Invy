<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:pages="using:Invy.Client.Core.Pages"
             x:Class="Invy.Client.UI.Views.Pages.SettingsPage"
             x:DataType="pages:SettingsPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,4,24,24" Spacing="4" MaxWidth="960">
      <TextBlock Text="Оформление" FontWeight="SemiBold" Margin="0,8,0,8" />
      <ui:FASettingsExpander Header="Тема" Description="Светлая, тёмная или как в системе" IconSource="DarkTheme">
        <ui:FASettingsExpander.Footer>
          <ComboBox x:Name="ThemeSelector" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" MinWidth="180" />
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>

      <StackPanel Spacing="4" IsVisible="{Binding IsConnected}">
        <TextBlock Text="Сервер" FontWeight="SemiBold" Margin="0,16,0,8" />
        <ui:FASettingsExpander Header="Подключено" Description="{Binding ConnectionText}" IconSource="Globe">
          <ui:FASettingsExpander.Footer>
            <Button Content="Сменить сервер" Command="{Binding DisconnectCommand}" />
          </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding HasUpdater}">
        <TextBlock Text="Подключение и обновления" FontWeight="SemiBold" Margin="0,16,0,8" />
        <ui:FASettingsExpander Header="Сервер Invy" Description="Адрес в домашней сети, например 192.168.1.10" IconSource="Globe">
          <ui:FASettingsExpander.Footer>
            <TextBox Text="{Binding ServerAddress}" PlaceholderText="192.168.1.10:5470" MinWidth="220" />
          </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="Обновления" Description="{Binding UpdateStatus}" IconSource="Download">
          <ui:FASettingsExpander.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Проверить" Command="{Binding CheckForUpdatesCommand}" />
              <Button Content="Установить" Classes="accent" Command="{Binding InstallUpdateCommand}"
                      IsVisible="{Binding ReadyVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
