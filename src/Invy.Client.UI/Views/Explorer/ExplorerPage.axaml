<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:explorer="using:Invy.Client.Core.Explorer"
             xmlns:catalog="using:Invy.Contracts.Catalog"
             xmlns:controls="using:Invy.Client.UI.Controls"
             xmlns:conv="using:Invy.Client.UI.Converters"
             xmlns:photos="using:Invy.Client.UI.Views.Photos"
             x:Class="Invy.Client.UI.Views.Explorer.ExplorerPage"
             x:DataType="explorer:ExplorerViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding AddCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding AddContainerCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ShowListCommand}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding ShowTilesCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+M" Command="{Binding MoveToCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding UpCommand}" />
    <KeyBinding Gesture="Back" Command="{Binding UpCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="ListBoxItem.cut, Border.cut">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ListBox#ItemsList ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ListBox#TilesList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem.drop-target, TreeViewItem.drop-target">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16,0,24,16">
    <!-- Команды -->
    <Grid ColumnDefinitions="*,Auto">
      <ui:FACommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" HorizontalAlignment="Left">
        <ui:FACommandBar.PrimaryCommands>
          <ui:FACommandBarButton Label="{Binding AddText}" IconSource="Add" Command="{Binding AddCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Ctrl+N" />
          <ui:FACommandBarSeparator IsVisible="{Binding CanEdit}" />
          <ui:FACommandBarButton Label="Изменить" IconSource="Edit" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="F2" />
          <ui:FACommandBarButton Label="Вырезать" IconSource="Cut" Command="{Binding CutCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Ctrl+X" />
          <ui:FACommandBarButton Label="Вставить" IconSource="Paste" Command="{Binding PasteCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Ctrl+V" />
          <ui:FACommandBarButton Label="Переместить в…" IconSource="MoveToFolder" Command="{Binding MoveToCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Ctrl+Shift+M" />
          <ui:FACommandBarButton Label="Копия" IconSource="Copy" Command="{Binding DuplicateCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Ctrl+D" />
          <ui:FACommandBarButton Label="Удалить" IconSource="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Delete" />
        </ui:FACommandBar.PrimaryCommands>
        <ui:FACommandBar.SecondaryCommands>
          <ui:FACommandBarButton Label="Обновить" IconSource="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="F5" />
        </ui:FACommandBar.SecondaryCommands>
      </ui:FACommandBar>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" MinWidth="170" ToolTip.Tip="Сортировка" />
        <ToggleButton IsChecked="{Binding !IsTiles}" ToolTip.Tip="Список (Ctrl+1)" Padding="8">
          <ui:FASymbolIcon Symbol="List" FontSize="16" />
        </ToggleButton>
        <ToggleButton IsChecked="{Binding IsTiles}" ToolTip.Tip="Плитки (Ctrl+3)" Padding="8">
          <ui:FASymbolIcon Symbol="ViewAll" FontSize="16" />
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- Путь -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8,4,0,12">
      <Button Command="{Binding UpCommand}" ToolTip.Tip="На уровень выше (Alt+↑)" Padding="6" Margin="0,0,8,0" Theme="{DynamicResource TransparentButton}">
        <ui:FASymbolIcon Symbol="Up" FontSize="16" />
      </Button>
      <ui:FABreadcrumbBar x:Name="Breadcrumbs" Grid.Column="1" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
        <ui:FABreadcrumbBar.ItemTemplate>
          <DataTemplate x:DataType="explorer:Breadcrumb">
            <ui:FABreadcrumbBarItem Content="{Binding Name}" />
          </DataTemplate>
        </ui:FABreadcrumbBar.ItemTemplate>
      </ui:FABreadcrumbBar>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasCut}" VerticalAlignment="Center">
        <ui:FASymbolIcon Symbol="Cut" FontSize="14" Opacity="0.7" />
        <TextBlock Text="{Binding CutText}" Classes="secondary" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
        <Button Content="Отменить" Command="{Binding ClearCutCommand}" Theme="{DynamicResource TransparentButton}" FontSize="12" Padding="6,2" />
      </StackPanel>
    </Grid>

    <!-- Дерево | содержимое | карточка -->
    <Grid Grid.Row="2" ColumnDefinitions="250,6,*,6,320">
      <Border Classes="card" Padding="4" IsVisible="{Binding ShowTree}">
        <TreeView x:Name="PlacesTree" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}" DragDrop.AllowDrop="True">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="explorer:PlaceNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="explorer:PlaceNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:ItemIcon Icon="{Binding Icon}" Role="{Binding Role}" Tint="{Binding Color}" Size="16" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>
      <GridSplitter Grid.Column="1" Background="Transparent" IsVisible="{Binding ShowTree}" />

      <Border Grid.Column="2" Classes="card">
        <Panel Background="Transparent">
          <Panel.ContextFlyout>
            <MenuFlyout>
              <MenuItem Header="Открыть" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem}" InputGesture="Enter" />
              <MenuItem Header="Изменить" Command="{Binding EditCommand}" InputGesture="F2" IsVisible="{Binding CanEdit}" />
              <Separator IsVisible="{Binding CanEdit}" />
              <MenuItem Header="Вырезать" Command="{Binding CutCommand}" InputGesture="Ctrl+X" IsVisible="{Binding CanEdit}" />
              <MenuItem Header="Вставить сюда" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" IsVisible="{Binding CanEdit}" />
              <MenuItem Header="Переместить в…" Command="{Binding MoveToCommand}" InputGesture="Ctrl+Shift+M" IsVisible="{Binding CanEdit}" />
              <MenuItem Header="Создать копию" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D" IsVisible="{Binding CanEdit}" />
              <Separator IsVisible="{Binding CanEdit}" />
              <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGesture="Delete" IsVisible="{Binding CanEdit}" />
            </MenuFlyout>
          </Panel.ContextFlyout>

          <!-- Список -->
          <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Multiple"
                   IsVisible="{Binding !IsTiles}" Background="Transparent" DragDrop.AllowDrop="True">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="explorer:ItemRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Classes.cut="{Binding IsCut}" Background="Transparent">
                  <Panel Width="32" Height="32" Margin="0,0,12,0">
                    <controls:ItemIcon Icon="{Binding Item.Icon}" Role="{Binding Item.Role}" Tint="{Binding Color}" Size="20"
                                       IsVisible="{Binding !HasThumbnail}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                      <Image Source="{Binding Thumbnail, Converter={x:Static conv:BitmapConverters.Thumbnail}}" Stretch="UniformToFill" />
                    </Border>
                  </Panel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" Classes="secondary" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Плитки -->
          <ListBox x:Name="TilesList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Multiple"
                   IsVisible="{Binding IsTiles}" Background="Transparent" Padding="8" DragDrop.AllowDrop="True">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="explorer:ItemRowViewModel">
                <Border Width="148" Height="150" Padding="10" Classes.cut="{Binding IsCut}" Background="Transparent">
                  <StackPanel Spacing="6">
                    <Border Height="72" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <Panel>
                        <controls:ItemIcon Icon="{Binding Item.Icon}" Role="{Binding Item.Role}" Tint="{Binding Color}" Size="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                        <Image Source="{Binding Thumbnail, Converter={x:Static conv:BitmapConverters.Thumbnail}}" Stretch="UniformToFill"
                               IsVisible="{Binding HasThumbnail}" />
                      </Panel>
                    </Border>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" Classes="secondary" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Пусто -->
          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360" Margin="24">
            <ui:FASymbolIcon Symbol="OpenFolder" FontSize="40" Opacity="0.5" />
            <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
            <Button Content="{Binding AddText}" Classes="accent" Command="{Binding AddCommand}" IsVisible="{Binding CanEdit}"
                    HorizontalAlignment="Center" Margin="0,8,0,0" />
          </StackPanel>

          <ui:FAProgressRing IsVisible="{Binding IsLoading}" IsIndeterminate="True" Width="28" Height="28"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        </Panel>
      </Border>

      <GridSplitter Grid.Column="3" Background="Transparent" />

      <!-- Карточка -->
      <Border Grid.Column="4" Classes="card" x:Name="CardPane" DragDrop.AllowDrop="True">
        <Panel>
          <TextBlock Text="Выберите вещь, чтобы увидеть подробности" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNull}}"
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" VerticalAlignment="Center" Margin="24" />
          <ScrollViewer IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel DataContext="{Binding Details}" x:DataType="explorer:ItemCardViewModel" Margin="20" Spacing="12">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                  <controls:ItemIcon Icon="{Binding Item.Icon}" Role="{Binding Item.Role}" Tint="{Binding Item.Color}" Size="28"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <SelectableTextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                </StackPanel>
              </Grid>

              <photos:PhotoStripView DataContext="{Binding Photos}" />

              <Grid ColumnDefinitions="Auto,*">
                <ui:FASymbolIcon Symbol="MapPin" FontSize="14" Opacity="0.7" Margin="0,2,6,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding PathText}" TextWrapping="Wrap" />
              </Grid>
              <TextBlock Text="{Binding QuantityText}" IsVisible="{Binding QuantityText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding ContentsText}" IsVisible="{Binding ContentsText, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="explorer:CardField">
                    <Grid ColumnDefinitions="120,*" Margin="0,3">
                      <TextBlock Text="{Binding Label}" Classes="secondary" TextWrapping="Wrap" Margin="0,0,8,0" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="catalog:TagDto">
                    <Border CornerRadius="12" Padding="10,3" Margin="0,0,6,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <TextBlock Text="{Binding Name, StringFormat='#{0}'}" FontSize="12" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <SelectableTextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding UpdatedText}" Classes="secondary" />
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
