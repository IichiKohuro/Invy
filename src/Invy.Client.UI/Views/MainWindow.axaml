<win:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:win="using:FluentAvalonia.UI.Windowing"
                 xmlns:shell="using:Invy.Client.Core.Shell"
                 xmlns:views="using:Invy.Client.UI.Views"
                 x:Class="Invy.Client.UI.Views.MainWindow"
                 x:DataType="shell:ShellViewModel"
                 Title="Invy"
                 Width="1100" Height="720"
                 MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <!-- Заголовок окна в стиле Windows 11: название приложения и поиск. Справа — место под кнопки окна. -->
    <Grid Grid.Row="0" Height="48" ColumnDefinitions="Auto,*,140" Background="Transparent">
      <TextBlock Grid.Column="0" Text="Invy" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
      <TextBox Grid.Column="1" x:Name="TitleSearch"
               PlaceholderText="Поиск вещей… (Ctrl+F)"
               MaxWidth="520" Margin="24,0" Height="32"
               HorizontalAlignment="Stretch" VerticalAlignment="Center" />
    </Grid>

    <views:MainView Grid.Row="1" />
  </Grid>
</win:FAAppWindow>
