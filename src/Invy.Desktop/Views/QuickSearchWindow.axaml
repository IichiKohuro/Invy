<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invy.Desktop.Views.QuickSearchWindow"
        Title="Invy — быстрый поиск"
        Width="640" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" Topmost="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <!-- Окно в духе PowerToys Run: поле ввода и подсказка по клавишам -->
  <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
    <StackPanel Spacing="10">
      <TextBox x:Name="Query" FontSize="18" PlaceholderText="Что ищем? Например: кабель usb-c" />
      <TextBlock Text="Enter — найти в Invy  ·  Esc — закрыть" FontSize="12" Opacity="0.6" />
    </StackPanel>
  </Border>
</Window>
