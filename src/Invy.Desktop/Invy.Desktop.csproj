<Project Sdk="Microsoft.NET.Sdk">
  <!-- Хост Windows: окно с Mica, трей, глобальные горячие клавиши, один экземпляр, Velopack.
       TFM net10.0 (а не net10.0-windows): Windows-код защищён проверками OperatingSystem.IsWindows(),
       поэтому приложение собирается и запускается и на Linux (удобно для CI и отладки UI). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Invy.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invy.Client.UI\Invy.Client.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Invy.Client.Tests" />
  </ItemGroup>
</Project>
