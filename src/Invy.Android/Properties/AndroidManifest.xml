<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="internalOnly">
  <!-- Связь с сервером Invy в домашней сети -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Обнаружение сервера UDP-широковещанием (фаза 5) -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- Самообновление: установка APK, загруженного с сервера Invy -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Android 12+: обновление без подтверждения, если Invy — источник установки (installer of record) -->
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <!-- Android 14+: Invy остаётся источником обновлений для самого себя -->
  <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application android:label="Invy"
               android:icon="@drawable/icon"
               android:networkSecurityConfig="@xml/network_security_config"
               android:supportsRtl="true" />
</manifest>
